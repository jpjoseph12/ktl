# Copy to android/keystore.properties (git-ignored) and fill in.
# storeFile is relative to this android/ folder. Keep the .jks file and
# these passwords backed up somewhere safe outside the repo: every update
# to the app has to be signed with the same key, and a lost key means
# everyone reinstalling.
#
# In the GitHub release workflow the same four come from repository
# secrets instead (see .github/workflows/release.yml).
storeFile=../../ktl-release-key.jks
storePassword=
keyAlias=ktl
keyPassword=
