# Copy to android/keystore.properties (git-ignored) and fill in.
# storeFile is relative to this android/ folder. Keep the .jks file and
# these passwords backed up somewhere safe outside the repo — with Play App
# Signing, Google can reset a lost UPLOAD key, but only after you contact
# support, and releases stop until then.
storeFile=../../ktl-upload-key.jks
storePassword=
keyAlias=upload
keyPassword=
