<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep app data out of Google Drive backups AND out of
     device-to-device transfers. allowBackup="false" alone only stops the
     former. The signed-in session and cached private figures (pay, debts)
     live in the WebView's storage; everything real is in the account and
     comes back by signing in on the new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
