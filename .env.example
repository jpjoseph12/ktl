# Optional. Copy to .env for local development or a preconfigured app build.
#
# The web app always talks to the server it's served from, so a server's
# own build needs nothing here. Set this only to:
#   - run `npm run dev` against a server elsewhere (e.g. http://192.168.1.20:8095), or
#   - build an Android app that connects to your server without asking.
# Leave it unset for an Android app that asks for the address on first launch.
VITE_SERVER_URL=
